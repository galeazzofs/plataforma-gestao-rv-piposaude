# ── Required ────────────────────────────────────────────────────────
FLASK_ENV=dev

# Sign JWTs. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# In stag/prod the app refuses to start without this set.
SECRET_KEY=change-me-locally-or-app-wont-start

# Comma-separated list of allowed frontend origins. In dev there's a
# fallback (http://localhost:3000,http://localhost:8080); in stag/prod
# the app refuses to start without this set.
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/comissoes_dev
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/comissoes_test

# ── Dev only (NEVER set in stag/prod) ───────────────────────────────
# Enables /api/v1/auth/dev-login + /api/v1/auth/dev-users (used to
# log in as any seeded user without Google OAuth).
# DEV_LOGIN_ENABLED=true

# ── Integrations ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback
HUBSPOT_TOKEN=
SLACK_BOT_TOKEN=