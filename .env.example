# === Docker Compose Environment ===
# Copy this file to .env and fill in the values

# --- Postgres ---
POSTGRES_USER=comissoes
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=comissoes

# --- Backend ---
FLASK_ENV=prod
SECRET_KEY=CHANGE_ME_generate_with_python_c_import_secrets_secrets_token_hex_32

# Google OAuth (login com @piposaude.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/api/v1/auth/google/callback

# HubSpot
HUBSPOT_TOKEN=
HUBSPOT_SYNC_INTERVAL_MINUTES=30

# Slack
SLACK_BOT_TOKEN=
# Channel ID (e.g. C0123456) or #channel-name. Leave empty to disable.
SLACK_OPS_CHANNEL=
SLACK_FINANCE_CHANNEL=
# Public base URL of the platform — used to build the "Ver na plataforma" links.
PLATFORM_PUBLIC_URL=

# CORS
CORS_ORIGINS=https://YOUR_DOMAIN
